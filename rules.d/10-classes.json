    {
      "comm": "rtk",
      "exe": "/home/linuxbrew/.linuxbrew/Cellar/rtk/0.49.0/bin/rtk",
      "cmdline": [
        "rtk",
        "bun",
        "run",
        "dev"
      ],
      "expect": {
        "classes": [
          "launcher"
        ]
      }
    },
    {
      "comm": "rustc",
      "exe": "/home/u/.rustup/toolchains/1.98.0-x86_64-unknown-linux-gnu/bin/rustc",
      "cmdline": [
        "rustc",
        "--crate-name",
